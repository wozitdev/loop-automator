; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Loop Automator"
config/version="0.0.0-dev"
config/description="Visual TAS-style builder for automated mouse/keyboard loops with a screen overlay."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.1216, 0.1412, 0.1882, 1)
boot_splash/show_image=false

[autoload]

ProjectData="*res://scripts/autoload/project_data.gd"
Playback="*res://scripts/autoload/playback_engine.gd"

[display]

window/size/viewport_width=1320
window/size/viewport_height=640
window/subwindows/embed_subwindows=false
window/per_pixel_transparency/allowed=true

[rendering]

; The overlay needs per-pixel window transparency. On Windows the Forward+ and
; Mobile (Vulkan) renderers usually cannot composite transparent windows (the
; overlay shows up as an opaque black window), so use Compatibility everywhere.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
